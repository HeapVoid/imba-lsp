{
  "name": "tree-sitter-imba",
  "version": "0.0.1",
  "private": true,
  "description": "Tree-sitter grammar and Zed extension scaffold for Imba",
  "type": "commonjs",
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse:sample": "tree-sitter parse examples/sample.imba",
    "zed:build-grammar": "bash scripts/check-zed-grammar-build.sh",
    "zed:check-extension": "bash scripts/check-zed-extension.sh",
    "lsp:build": "npm --prefix lsp run build",
    "lsp:probe": "npm run lsp:build && node lsp/dist/src/probe.js",
    "lsp:test": "npm --prefix lsp test"
  },
  "keywords": [
    "imba",
    "tree-sitter",
    "zed"
  ],
  "devDependencies": {
    "tree-sitter-cli": "^0.25.10"
  },
  "tree-sitter": [
    {
      "scope": "source.imba",
      "file-types": [
        "imba"
      ],
      "highlights": [
        "languages/imba/highlights.scm"
      ]
    }
  ]
}
